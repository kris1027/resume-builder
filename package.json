{
    "name": "resume-builder",
    "private": true,
    "version": "0.0.0",
    "description": "A modern resume builder with multiple templates, dark mode, i18n, and PDF export",
    "author": "Kris1027",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "https://github.com/Kris1027/resume-builder.git"
    },
    "homepage": "https://github.com/Kris1027/resume-builder",
    "bugs": {
        "url": "https://github.com/Kris1027/resume-builder/issues"
    },
    "keywords": [
        "cv",
        "resume",
        "builder",
        "react",
        "typescript",
        "pdf",
        "pwa"
    ],
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "pre-commit": "prettier --write . && eslint . && vitest run && tsc -b && vite build"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-slot": "^1.2.3",
        "@react-pdf/renderer": "^4.9.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-router": "^1.170.45",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "i18next": "^26.4.7",
        "i18next-browser-languagedetector": "^8.2.0",
        "lucide-react": "^1.59.0",
        "motion": "^13.5.1",
        "pdfjs-dist": "^6.4.299",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.0.20",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tanstack/router-plugin": "^1.168.47",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^5.0.5",
        "workbox-window": "^7.4.1"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.14.0"
}
